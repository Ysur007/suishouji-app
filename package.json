{
  "name": "suishouji",
  "version": "1.3.13",
  "private": true,
  "type": "module",
  "description": "随手记 · 像发消息一样记笔记，多端实时同步",
  "scripts": {
    "dev": "concurrently -n api,web -c magenta,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "start": "tsx server/index.ts",
    "preview": "npm run build && npm start",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=cjs --target=node20 --outfile=dist-server/server.cjs --external:bufferutil --external:utf-8-validate",
    "build:desktop": "npm run build && npm run build:server && node scripts/pack-desktop.mjs",
    "build:android": "npm run build && cap sync android && cd android && ./gradlew assembleDebug",
    "deploy:landing": "bash scripts/deploy-landing.sh"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.3",
    "@capacitor/app": "^6.0.3",
    "@capacitor/core": "^6.2.3",
    "framer-motion": "^11.15.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.19.2",
    "ws": "^8.18.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.3",
    "@electron/packager": "^18.4.4",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^31.7.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  },
  "engines": {
    "node": ">=20.11"
  }
}
